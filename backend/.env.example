# Copy to backend/.env and fill in. Never commit .env.

# Local docker Postgres (docker compose up -d db). No password: trust auth on localhost only.
# For Supabase use the session pooler string from Project -> Connect, with the
# "postgresql+asyncpg://" prefix. The transaction pooler (port 6543) also works.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/splitease

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated, no wildcard.
CORS_ORIGINS=http://localhost:5000

# dev or prod (prod hides /docs)
ENV=dev
